{
    "name": "google/apiclient",
    "type": "library",
    "description": "Client library for Google APIs",
    "keywords": ["google"],
    "homepage": "http://developers.google.com/api-client-library/php",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "google/auth": "^1.50",
        "google/apiclient-services": "~0.13",
        "firebase/php-jwt": "^7.0",
        "monolog/monolog": "^2.10",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/cache": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/dom-crawler": "^6.4",
        "symfony/css-selector": "^6.4",
        "symfony/cache": "^6.4"
    },
    "suggest": {
        "symfony/cache": "For filesystem certificate and token caching (using Google_Client::setCache)"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit --configuration ../../../../phpunit.xml.dist"
    },
    "autoload": {
        "psr-0": {
            "Google_": "src/"
        },
        "classmap": [
            "src/Google/Service/"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    }
}
