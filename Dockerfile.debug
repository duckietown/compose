ARG ARCH=amd64
ARG BASE_ORGANIZATION=duckietown
ARG BASE_VERSION=php8.3

FROM ${BASE_ORGANIZATION}/compose:${BASE_VERSION}-${ARCH}

COPY --chmod=755 assets/check-php-security.sh /usr/local/bin/check-php-security
RUN check-php-security "${PHP_VERSION:-8.3}"
COPY assets/entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

# install dependencies, then clean the apt cache
RUN apt-get update \
  && apt-get install -y \
    graphviz \
    doxygen \
  # clean the apt cache
  && rm -rf /var/lib/apt/lists/*

# install \compose\ (from working directory)
RUN rm -rf "${COMPOSE_DIR}"
COPY ./ "${COMPOSE_DIR}"
COPY assets.debug/git_config "${COMPOSE_DIR}/.git/config"

# install WebGrind to visualize the profiler data
RUN git clone --depth 1 https://github.com/jokkedk/webgrind.git $COMPOSE_DIR/public_html/webgrind/

# install Xdebug for the selected PHP branch
RUN apt-get update && \
  apt-get install -y --no-install-recommends php${PHP_VERSION}-xdebug && \
  rm -rf /var/lib/apt/lists/*
COPY assets.debug/usr/local/etc/php/conf.d/xdebug.ini /etc/php/${PHP_VERSION}/mods-available/compose-xdebug.ini
RUN phpenmod -v "${PHP_VERSION}" compose-xdebug

# copy APCu monitor script
ADD assets.debug/apc.php $COMPOSE_DIR/public_html/
